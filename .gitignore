.claude/settings.local.json

# Node
node_modules/
app/dist/

# Editor/OS
.vscode/
.DS_Store
Thumbs.db

# Generated by the pipeline (python -m pipeline.build_dataset); rebuild locally.
# Schlieren is the one municipality this milestone is built around, so its dataset (and an index.json
# listing just it) is tracked instead, letting a fresh clone run the game without the pipeline. The
# pipeline's `write_index()` rescans app/public/data/ and will regenerate index.json with every locally
# built municipality in it — trim it back to the schlieren entry before committing.
app/public/data/*
!app/public/data/schlieren.json
!app/public/data/index.json
